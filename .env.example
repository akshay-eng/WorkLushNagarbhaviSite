# Copy to .env.local and fill in.

# Signs the session cookie. 32+ random characters; required in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Razorpay (the gateway the current WordPress site already uses).
# Leave both empty to run checkout in clearly-labelled demo mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Where users, bookings and uploaded ID files are stored. Defaults to ./.data
# DATA_DIR=/var/lib/worklush
